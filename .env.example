# AusaGuide Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env or .env.local — they are in .gitignore.

# ── Supabase ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Mapbox ────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ── Payments Feature Toggle ───────────────────────────────
# Set to "false" to show maintenance banner (safe default).
# Set to "true" to enable live checkout and payment flow.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
VITE_PAYMENTS_ENABLED=false

# ─────────────────────────────────────────────────────────
# The variables below are SERVER-SIDE ONLY.
# They belong in Supabase Edge Function Secrets and Vercel
# Environment Variables — NEVER put them in the frontend bundle.
# ─────────────────────────────────────────────────────────

# ── IntaSend Gateway (Server-Side / Supabase Edge Functions) ──────
# Get from: IntaSend Dashboard → Developers → API Keys
# Use LIVE keys for production, TEST keys for sandbox only.
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_live_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── IntaSend Webhook Secret (Server-Side) ─────────────────
# Get from: IntaSend Dashboard → Developers → Webhooks → Secret
INTASEND_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── IntaSend Wallet ID (optional, for B2C payouts) ────────
INTASEND_WALLET_ID=your_wallet_id_here

# ── Supabase Service Role (Server-Side Vercel cron only) ──
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# NEVER expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ── Site URL (used for redirect/callback URLs) ────────────
SITE_URL=https://ausaguide.com

# ── Cron Auth Secret (Server-Side) ────────────────────────
# Protects the /api/cron/process-completed-payouts endpoint.
# Generate with: openssl rand -hex 32
# Must be set as Vercel env var AND sent as "Authorization: Bearer <value>"
# by your Vercel cron trigger or any external scheduler.
CRON_SECRET=generate_with_openssl_rand_hex_32
