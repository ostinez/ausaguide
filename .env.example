# AusaGuide Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Mapbox ────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ── Payments Feature Toggle ───────────────────────────────
# Set to "false" to show maintenance banner and redirect checkout to waitlist.
# Set to "true" to enable checkout and payment flow.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
VITE_PAYMENTS_ENABLED=false

# ── IntaSend Gateway Configuration (Server-Side) ───────────
# Publishable and Secret keys configured in Supabase Edge Functions / Vercel
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_your_key_here
INTASEND_SECRET_KEY=ISSecretKey_test_your_key_here
INTASEND_WEBHOOK_SECRET=your_webhook_secret_here

# ─────────────────────────────────────────────────────────
# SECURITY NOTES:
# - NEVER put INTASEND_SECRET_KEY in frontend bundle
# - Secret keys belong ONLY in backend serverless/edge environments
# ─────────────────────────────────────────────────────────
